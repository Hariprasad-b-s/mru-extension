{
  "manifest_version": 3,
  "name": "MRU tab switcher - Smooth like brave browser",
  "version": "1.0.0",
  "description": "Jump to your most recently used tab with a shortcut, and tap again to go further back. Works with Ctrl+Tab. No overlays.",
  "minimum_chrome_version": "110",

  "key": "",

  "background": {
    "service_worker": "background.js"
  },

  "permissions": ["storage"],

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "action": {
    "default_title": "MRU Tab Switcher",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },

  "commands": {
    "switch-to-previous-tab": {
      "suggested_key": {
        "default": "Alt+Y",
        "mac": "MacCtrl+Y"
      },
      "description": "Switch to the most recently used tab in this window (press repeatedly to go further back)"
    }
  }
}
